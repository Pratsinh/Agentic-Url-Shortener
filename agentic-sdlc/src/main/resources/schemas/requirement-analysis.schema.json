{
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "problemStatement", "acceptanceCriteria", "ambiguities", "impactedAreas", "risks", "outOfScope"],
  "properties": {
    "kind": {"type": "string", "enum": ["GREENFIELD", "BROWNFIELD", "AMBIGUOUS"], "description": "GREENFIELD: new capability; BROWNFIELD: change to existing behaviour; AMBIGUOUS: cannot be engineered without human decisions"},
    "title": {"type": "string", "minLength": 5, "maxLength": 100},
    "problemStatement": {"type": "string", "minLength": 30, "description": "the requirement restated as a precise engineering problem"},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "maxItems": 15, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {"id": {"type": "string", "pattern": "^AC-[0-9]+$"}, "text": {"type": "string", "minLength": 10, "description": "testable, observable behaviour"}}}},
    "ambiguities": {"type": "array", "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "question", "whyItMatters", "proposedAssumption", "blocking"],
      "properties": {
        "id": {"type": "string", "pattern": "^AMB-[0-9]+$"},
        "question": {"type": "string", "minLength": 10},
        "whyItMatters": {"type": "string", "minLength": 10},
        "proposedAssumption": {"type": "string", "minLength": 5, "description": "the default you would apply if a human approves it"},
        "blocking": {"type": "boolean"}}}},
    "impactedAreas": {"type": "array", "minItems": 1, "maxItems": 25, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "changeType", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 3, "description": "repository-relative file path"},
        "changeType": {"type": "string", "enum": ["NEW", "MODIFY", "CONTEXT"]},
        "reason": {"type": "string", "minLength": 5}}}},
    "risks": {"type": "array", "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false, "required": ["description", "mitigation"],
      "properties": {"description": {"type": "string", "minLength": 5}, "mitigation": {"type": "string", "minLength": 5}}}},
    "outOfScope": {"type": "array", "maxItems": 10, "items": {"type": "string"}}
  }
}
