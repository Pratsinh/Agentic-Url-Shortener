package com.ascs.agentic;

import com.ascs.agentic.agents.PlanValidator;
import com.ascs.agentic.human.FileHumanChannel;
import com.ascs.agentic.human.HumanApprovalGateway;
import com.ascs.agentic.human.HumanChannel;
import com.ascs.agentic.model.Models;
import com.ascs.orchestrator.audit.AuditLog;
import com.ascs.orchestrator.model.ApprovalRequest;
import com.ascs.orchestrator.model.Decision;
import com.ascs.orchestrator.model.Impact;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;

import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Clock;
import java.time.Duration;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.TimeUnit;

import static org.junit.jupiter.api.Assertions.*;

/** Deterministic decision logic: plan validation, clarification parsing, separation of duties, the file channel. */
class DecisionLogicTest {

    static final List<String> MODULES = List.of("shortener-service", "shortener-api");

    static Models.RequirementAnalysis analysis(String... criteria) {
        return new Models.RequirementAnalysis("GREENFIELD", "title", "problem", java.util.Arrays.stream(criteria)
                .map(c -> new Models.Criterion(c, "text " + c)).toList(), List.of(), List.of(), List.of(), List.of());
    }

    static Models.PlanTask task(String id, List<String> deps, List<String> files, String... criteria) {
        return new Models.PlanTask(id, "title " + id, "description of " + id, "shortener-service", files, deps, List.of(criteria));
    }

    static Models.Plan plan(Models.PlanTask... tasks) {
        return new Models.Plan("summary", "design", List.of(tasks), "tests", "compat", "rollback", null);
    }

    @Test
    void aValidPlanPassesAndSharedFilesAreSerializedDeterministically() {
        String a = "shortener-service/src/main/java/A.java", b = "shortener-service/src/main/java/B.java";
        Models.Plan p = plan(task("T1", List.of(), List.of(a), "AC-1"), task("T2", List.of(), List.of(b), "AC-2"),
                task("T3", List.of(), List.of(a, b), "AC-1"));
        assertEquals(List.of(), PlanValidator.validate(p, analysis("AC-1", "AC-2"), MODULES));
        Models.Plan adjusted = PlanValidator.serializeSharedFiles(p);
        assertEquals(List.of(), adjusted.tasks().get(1).dependsOn(), "T1 and T2 share nothing: they stay parallel");
        assertEquals(List.of("T1", "T2"), adjusted.tasks().get(2).dependsOn());
        assertEquals(2, adjusted.orchestratorAdjustments().size());
    }

    @Test
    void structuralScopeAndCoverageErrorsAreReported() {
        Models.Plan p = plan(task("T1", List.of("T2"), List.of("shortener-service/x.java"), "AC-1"),
                task("T2", List.of("T1"), List.of("pom.xml", "orchestrator/src/X.java", "../x"), "AC-9"));
        List<String> errors = PlanValidator.validate(p, analysis("AC-1", "AC-2"), MODULES);
        assertTrue(errors.contains("T2 references unknown criterion AC-9"), errors::toString);
        assertTrue(errors.contains("acceptance criterion AC-2 is not covered by any task"), errors::toString);
        assertTrue(errors.stream().anyMatch(e -> e.contains("orchestrator/src/X.java") && e.contains("outside the writable modules")));
        assertTrue(errors.stream().anyMatch(e -> e.contains("'../x'")));
        List<String> cycle = PlanValidator.validate(plan(task("T1", List.of("T2"), List.of("shortener-service/a"), "AC-1"),
                task("T2", List.of("T1"), List.of("shortener-service/b"), "AC-1")), analysis("AC-1"), MODULES);
        assertTrue(cycle.get(0).startsWith("task graph is invalid: cycle detected"), cycle::toString);
    }

    @Test
    void clarificationsRecordAnswersAndExplicitlyApprovedAssumptionsAndRefuseGaps() throws Exception {
        var ambiguities = List.of(new Models.Ambiguity("AMB-1", "TTL?", "w", "30 days", true),
                new Models.Ambiguity("AMB-2", "Format?", "w", "ISO-8601", false));
        var m = ClarificationParse.resolve(ambiguities, new HumanChannel.Reply("pat", HumanChannel.Verdict.ANSWER,
                "AMB-1: 90 days\namb-2: accept", "console"));
        assertEquals(List.of("ANSWERED", "ASSUMPTION_APPROVED"), m.resolutions().stream().map(Models.Resolution::decision).toList());
        assertEquals("90 days", m.resolutions().get(0).text());
        assertEquals("ISO-8601", m.resolutions().get(1).text());
        assertThrows(IllegalArgumentException.class, () -> ClarificationParse.resolve(ambiguities,
                new HumanChannel.Reply("pat", HumanChannel.Verdict.ANSWER, "AMB-1: accept", "console")));
        assertEquals(2, ClarificationParse.resolve(ambiguities, new HumanChannel.Reply("pat", HumanChannel.Verdict.ANSWER,
                "ALL: accept", "console")).resolutions().size());
    }

    @Test
    void agentIdentitiesCannotApprove() {
        assertNull(HumanApprovalGateway.separationOfDutiesViolation("pat.lee"));
        for (String bad : List.of("implementer", "Reviewer", "llm", "agentic-sdlc", "claude", "x", "planner:auto")) {
            assertNotNull(HumanApprovalGateway.separationOfDutiesViolation(bad), bad);
        }
    }

    @Test
    void approvalGatewayRefusesAnAgentApproverAndRoutesRevisionsToReplanning() throws Exception {
        AuditLog audit = new AuditLog(Clock.systemUTC());
        ApprovalRequest req = new ApprovalRequest("run", "plan", Impact.MEDIUM, "s", Map.of("plan.md", "# plan"), List.of());

        CompletableFuture<Decision> d1 = new CompletableFuture<>();
        new HumanApprovalGateway(q -> Optional.of(new HumanChannel.Reply("implementer", HumanChannel.Verdict.APPROVE, "", "x")),
                audit, null).request(req, d1::complete);
        Decision refused = d1.get(5, TimeUnit.SECONDS);
        assertFalse(refused.approved());
        assertEquals("policy:separation-of-duties", refused.approver());

        CompletableFuture<String> revised = new CompletableFuture<>();
        CompletableFuture<Decision> d2 = new CompletableFuture<>();
        new HumanApprovalGateway(q -> Optional.of(new HumanChannel.Reply("pat", HumanChannel.Verdict.REVISE, "split T1", "x")),
                audit, (stage, who, text) -> revised.complete(stage + "/" + who + "/" + text)).request(req, d2::complete);
        assertEquals("plan/pat/split T1", revised.get(5, TimeUnit.SECONDS));
        assertFalse(d2.isDone(), "a revision is not a decision: the stale request is superseded by re-planning");
    }

    @Test
    void fileChannelWaitsForAResponseFileOutsideTheWorkspace(@TempDir Path inbox) throws Exception {
        FileHumanChannel ch = new FileHumanChannel(inbox, Duration.ofSeconds(10), Duration.ofMillis(50));
        HumanChannel.Question q = new HumanChannel.Question("run", "approve-release", "Approve release", "body",
                List.of(HumanChannel.Verdict.APPROVE, HumanChannel.Verdict.REJECT));
        CompletableFuture<Optional<HumanChannel.Reply>> f = CompletableFuture.supplyAsync(() -> {
            try { return ch.ask(q); } catch (InterruptedException e) { throw new IllegalStateException(e); }
        });
        Path request = inbox.resolve("approve-release.request.md");
        for (int i = 0; i < 100 && !Files.exists(request); i++) Thread.sleep(20);
        assertTrue(Files.readString(request).contains("decision: approve"));
        Files.writeString(inbox.resolve("approve-release.response.txt"), "decision: approve\nby: pat\nlooks good\n");
        HumanChannel.Reply r = f.get(10, TimeUnit.SECONDS).orElseThrow();
        assertEquals(new HumanChannel.Reply("pat", HumanChannel.Verdict.APPROVE, "looks good", r.channel()), r);
        assertTrue(Files.exists(inbox.resolve("approve-release.response.done")));
    }

    @Test
    void fileChannelTimesOutToEmptySoTheEngineFailsClosed(@TempDir Path inbox) throws Exception {
        FileHumanChannel ch = new FileHumanChannel(inbox, Duration.ofMillis(200), Duration.ofMillis(50));
        assertEquals(Optional.empty(), ch.ask(new HumanChannel.Question("run", "q", "t", "b", List.of(HumanChannel.Verdict.APPROVE))));
    }

    /** Access to the package-private parser. */
    static final class ClarificationParse {
        static Models.Clarifications resolve(List<Models.Ambiguity> a, HumanChannel.Reply r) throws Exception {
            var m = com.ascs.agentic.agents.ClarificationAgent.class.getDeclaredMethod("resolve", List.class, HumanChannel.Reply.class);
            m.setAccessible(true);
            try {
                return (Models.Clarifications) m.invoke(null, a, r);
            } catch (java.lang.reflect.InvocationTargetException e) {
                if (e.getCause() instanceof RuntimeException re) throw re;
                throw e;
            }
        }
    }
}
