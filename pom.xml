<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.ascs</groupId>
  <artifactId>ascs-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ascs-parent</name>
  <description>Governed agentic SDLC orchestrator and the URL shortener service it works on</description>

  <!--
    The orchestrator and the shortener never depend on each other's code; they meet only at the contract:
      shortener-api       OpenAPI contract of the shortener (the only thing a client may depend on)
      shortener-service   the URL shortener microservice (Spring Boot), implements shortener-api
      shortener-client    Java client generated from shortener-api at build time
      orchestrator        workflow engine, role agents and tool gateway (plain Java, no dependencies)
      orchestrator-tools  gateway tools over external systems; the shortener tools use shortener-client
  -->
  <modules>
    <module>shortener-api</module>
    <module>shortener-service</module>
    <module>shortener-client</module>
    <module>orchestrator</module>
    <module>orchestrator-tools</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- newer than Boot 3.3.5's 1.19.8: current Docker engines reject the old client API version -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Unit-test coverage per module: `mvn verify` writes <module>/target/site/jacoco/{index.html,jacoco.xml} and enforces the gate. -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.14</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals><goal>report</goal></goals>
            </execution>
            <!-- Regression gate. The target is 100%; the few documented, unreachable lines/branches are listed by the QA agent. -->
            <execution>
              <id>check</id>
              <phase>verify</phase>
              <goals><goal>check</goal></goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.99</minimum></limit>
                      <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.99</minimum></limit>
                      <limit><counter>METHOD</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
